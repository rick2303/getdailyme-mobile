{
  "expo": {
    "name": "getdailyme",
    "slug": "getdailyme-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "getdailyme",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#007EB6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.getdailyme.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:app.getdailyme.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "getdailyme necesita acceso a tu galería para adjuntar una foto a tus registros.",
        "NSPhotoLibraryAddUsageDescription": "getdailyme necesita permiso para guardar imágenes que generes desde la app.",
        "NSCameraUsageDescription": "getdailyme necesita acceso a la cámara para tomar una foto de tu registro.",
        "NSLocationWhenInUseUsageDescription": "getdailyme no usa tu ubicación. Este permiso lo requiere una librería de notificaciones, pero la app nunca accede a tu ubicación.",
        "NSHealthShareUsageDescription": "getdailyme lee tus pasos, minutos de ejercicio y sueño para registrarlos automáticamente en las actividades que tú elijas.",
        "NSHealthUpdateUsageDescription": "getdailyme no escribe datos en Salud; este permiso lo declara la librería de salud."
      },
      "buildNumber": "14",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.getdailyme.app",
          "group.com.getdailyme.app.onesignal"
        ],
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "package": "com.getdailyme.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#007EB6"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.getdailyme.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 1,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "getdailyme necesita acceso a tu galería para adjuntar una foto a tus registros.",
          "cameraPermission": "getdailyme necesita acceso a la cámara para tomar una foto de tu registro.",
          "microphonePermission": false
        }
      ],
      "expo-quick-actions",
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "9B9BZ24M35"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "GetdailymeWidget",
              "label": "Tu día",
              "description": "El progreso de hoy, tus pendientes y tu racha",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@kingstinct/react-native-healthkit",
      "react-native-health-connect"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.getdailyme.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.getdailyme.app.onesignal"
                    ]
                  }
                },
                {
                  "targetName": "GetdailymeWidget",
                  "bundleIdentifier": "com.getdailyme.app.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.getdailyme.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "0a35b136-db1d-4095-8404-7aa2b9367322"
      }
    },
    "owner": "thunderhnd"
  }
}
